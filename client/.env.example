# =============================================================================
# SpendWise Client — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env files with real credentials.
# =============================================================================

# --- Development ---
# VITE_API_URL=http://localhost:5000/api/v1
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Production ---
# VITE_API_URL=https://your-render-backend.onrender.com/api/v1
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required variables (set one pair above):
VITE_API_URL=http://localhost:5000/api/v1
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
