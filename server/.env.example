# =============================================================================
# SpendWise Server — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env files with real credentials.
# =============================================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB Atlas ---
# Development: use your Atlas dev cluster
# Production: use your Atlas production cluster with restricted network access
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/spendwise
DB_NAME=spendwise

# --- CORS / Frontend URL ---
# Development: Vite dev server default
# Production: your Vercel deployment domain (comma-separated for multiple)
FRONTEND_URL=http://localhost:5173

# --- Clerk Authentication ---
# Development: use pk_test_ / sk_test_ keys from Clerk dashboard
# Production: use pk_live_ / sk_live_ keys from Clerk production instance
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
